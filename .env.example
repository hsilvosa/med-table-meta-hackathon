# Template for .env (copy it to .env and fill in). Contains no secrets.
# Hugging Face token, only needed to download the gated SAM 3 / SAM 3.1 weights (leave empty if you are already logged in)
HF_TOKEN=

# Which vision-language model backend to use: meta (Meta Model API, default) or local (Qwen3.5-9B via llama-server)
VLM_BACKEND=meta

# Local vision-language model served by llama-server (used when VLM_BACKEND=local)
VLM_URL=http://127.0.0.1:8082/v1/chat/completions
VLM_MODEL_DIR=models/qwen3.5-9b

# Where the downloaded CIMA data lives (git-ignored)
CIMA_DATA_DIR=data/cima

# Meta Model API key (https://ai.developer.meta.com); standard tier only, never the -contributor models
META_TOKEN=
# Hard spending cap in USD
META_BUDGET_USD=100
